<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>twist_mux</name>
  <version>0.1.0</version>
  <description>
    Overlay for the twist_mux package: the same executable, launch file and
    config file names, with the Lean-backed node of ROSlean as the multiplexer.
    Not the upstream package; twist_marker and joystick_relay.py forward to
    upstream's when it is installed underneath.
  </description>
  <maintainer email="noreply@beneficialaifoundation.org">Beneficial AI Foundation</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/Beneficial-AI-Foundation/ROSlean</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>roslean_core</depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
