"""Forwards to the executable of the same name in upstream nav2_collision_monitor.

The ROSlean overlay package named nav2_collision_monitor provides the
collision monitor only. `ros2 run` and launch files look for executables in
the first package named nav2_collision_monitor on AMENT_PREFIX_PATH, which is
the overlay, so the collision detector of upstream would no longer be found.
This script is installed under its name. It looks through the other prefixes
for the real executable and replaces itself with it, arguments unchanged.
"""

import os
import sys


def main():
    name = os.path.basename(sys.argv[0])
    here = os.path.dirname(os.path.realpath(__file__))
    for var in ('AMENT_PREFIX_PATH', 'CMAKE_PREFIX_PATH'):
        for prefix in os.environ.get(var, '').split(os.pathsep):
            if not prefix:
                continue
            candidate = os.path.join(prefix, 'lib', 'nav2_collision_monitor', name)
            if not os.path.isfile(candidate) or not os.access(candidate, os.X_OK):
                continue
            if os.path.dirname(os.path.realpath(candidate)) == here:
                continue  # this script
            os.execv(candidate, [candidate] + sys.argv[1:])
    sys.exit(
        f'{name}: not provided by the ROSlean overlay of nav2_collision_monitor, and no '
        f'upstream nav2_collision_monitor was found under it on AMENT_PREFIX_PATH. Install '
        f'upstream nav2_collision_monitor (for example ros-$ROS_DISTRO-nav2-collision-monitor) '
        f'and source it before this workspace.')


if __name__ == '__main__':
    main()
