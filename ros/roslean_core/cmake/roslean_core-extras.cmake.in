# Loaded by find_package(roslean_core). Defines `roslean_core::roslean_core`.
set(ROSLEAN_ROOT "@ROSLEAN_ROOT@" CACHE PATH "Root of the ROSlean lake project")
include("${roslean_core_DIR}/lean_core.cmake")

if(NOT TARGET roslean_core::roslean_core)
  get_filename_component(_roslean_core_prefix "${roslean_core_DIR}/../../.." ABSOLUTE)
  add_library(roslean_core::roslean_core INTERFACE IMPORTED)
  set_target_properties(roslean_core::roslean_core PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_roslean_core_prefix}/include/roslean_core"
    INTERFACE_LINK_LIBRARIES "roslean_core::lean")
endif()
