<?xml version="1.0"?>
<!-- A furnished apartment for the twist_mux demo. Room: 9 m x 7 m, centred on
     the origin. Furniture comes from Gazebo Fuel (OpenRobotics, Creative
     Commons); Gazebo downloads and caches it on first launch. -->
<sdf version="1.9">
  <world name="apartment">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="floor">
      <static>true</static>
      <pose>0 0 0.0 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>9.0 7.0 0.02</size></box></geometry>
          <material><ambient>0.62 0.46 0.30 1</ambient><diffuse>0.62 0.46 0.30 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="rug">
      <static>true</static>
      <pose>-2.6 1.7 0.016 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>2.6 1.8 0.01</size></box></geometry>
          <material><ambient>0.45 0.20 0.20 1</ambient><diffuse>0.45 0.20 0.20 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static>
      <pose>0 3.56 0.8 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>9.24 0.12 1.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>9.24 0.12 1.6</size></box></geometry>
          <material><ambient>0.93 0.91 0.86 1</ambient><diffuse>0.93 0.91 0.86 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.56 0.8 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>9.24 0.12 1.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>9.24 0.12 1.6</size></box></geometry>
          <material><ambient>0.93 0.91 0.86 1</ambient><diffuse>0.93 0.91 0.86 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-4.56 0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.12 7.0 1.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.12 7.0 1.6</size></box></geometry>
          <material><ambient>0.93 0.91 0.86 1</ambient><diffuse>0.93 0.91 0.86 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>4.56 0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.12 7.0 1.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.12 7.0 1.6</size></box></geometry>
          <material><ambient>0.93 0.91 0.86 1</ambient><diffuse>0.93 0.91 0.86 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="wall_bedroom">
      <static>true</static>
      <pose>1.3 -2.4 0.8 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.12 2.2 1.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.12 2.2 1.6</size></box></geometry>
          <material><ambient>0.93 0.91 0.86 1</ambient><diffuse>0.93 0.91 0.86 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="wall_bedroom_top">
      <static>true</static>
      <pose>3.6 -1.0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.8 0.12 1.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.8 0.12 1.6</size></box></geometry>
          <material><ambient>0.93 0.91 0.86 1</ambient><diffuse>0.93 0.91 0.86 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <include>
      <name>sofa</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sofa</uri>
      <static>true</static>
      <pose>-2.6 3.0 0.0 0 0 0</pose>
    </include>
    <include>
      <name>armchair</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Armchair</uri>
      <static>true</static>
      <pose>-4.0 1.5 0.0 0 0 1.57</pose>
    </include>
    <include>
      <name>coffee_table</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Cafe table</uri>
      <static>true</static>
      <pose>-2.6 1.7 0.0 0 0 0</pose>
    </include>
    <include>
      <name>bookshelf</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Bookshelf</uri>
      <static>true</static>
      <pose>-4.3 -0.6 0.0 0 0 1.57</pose>
    </include>
    <include>
      <name>dining_table</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Dining Table</uri>
      <static>true</static>
      <pose>2.2 1.4 0.0 0 0 0</pose>
    </include>
    <include>
      <name>dining_chair_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Dining Chair</uri>
      <static>true</static>
      <pose>1.25 1.9 0 0 0 -1.57</pose>
    </include>
    <include>
      <name>dining_chair_2</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Dining Chair</uri>
      <static>true</static>
      <pose>3.15 1.9 0 0 0 1.57</pose>
    </include>
    <include>
      <name>dining_chair_3</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Dining Chair</uri>
      <static>true</static>
      <pose>1.25 0.9 0 0 0 -1.57</pose>
    </include>
    <include>
      <name>dining_chair_4</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Dining Chair</uri>
      <static>true</static>
      <pose>3.15 0.9 0 0 0 1.57</pose>
    </include>
    <include>
      <name>refrigerator</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Refrigerator</uri>
      <static>true</static>
      <pose>4.0 3.0 0.0 0 0 0</pose>
    </include>
    <include>
      <name>kitchen_sink</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/KitchenSink</uri>
      <static>true</static>
      <pose>2.6 3.1 0.0 0 0 0</pose>
    </include>
    <include>
      <name>cabinet</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Cabinet</uri>
      <static>true</static>
      <pose>0.9 3.2 0.0 0 0 0</pose>
    </include>
    <include>
      <name>desk</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Desk</uri>
      <static>true</static>
      <pose>-3.2 -3.0 0.0 0 0 0</pose>
    </include>
    <include>
      <name>office_chair</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Office Chair</uri>
      <static>true</static>
      <pose>-3.2 -2.2 0.0 0 0 0</pose>
    </include>
    <include>
      <name>bed</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Bed</uri>
      <static>true</static>
      <pose>3.2 -2.4 0.0 0 0 0</pose>
    </include>
  </world>
</sdf>
