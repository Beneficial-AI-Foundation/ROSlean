<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roslean_collision_monitor</name>
  <version>0.1.0</version>
  <description>Replacement for Nav2's collision monitor for stop and slowdown zones (one laser scan, circles, polygons, polygons fed by a topic; lifecycle node with bond, state topic, transforms from TF) whose decision logic is a Lean function with proved properties.</description>
  <maintainer email="noreply@beneficialaifoundation.org">Beneficial AI Foundation</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>roslean_core</depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <!-- The Nav2 extension: lifecycle node with bond, state message, transforms -->
  <depend>rclcpp_lifecycle</depend>
  <depend>rclcpp_components</depend>
  <depend>nav2_util</depend>
  <depend>nav2_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Gazebo demo (demo/gazebo): begin -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>roslean_twist_mux</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <!-- Gazebo demo: end -->

  <test_depend>rclpy</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>lifecycle_msgs</test_depend>
  <test_depend>nav2_msgs</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>nav2_collision_monitor</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
