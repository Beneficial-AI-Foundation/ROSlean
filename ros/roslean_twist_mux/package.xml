<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roslean_twist_mux</name>
  <version>0.1.0</version>
  <description>Replacement for the twist_mux node whose arbitration logic is a Lean function with proved properties.</description>
  <maintainer email="noreply@beneficialaifoundation.org">Beneficial AI Foundation</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>roslean_core</depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <!-- For launch/twist_mux_launch.py. The demos and their dependencies are in roslean_demos. -->
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>rclpy</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>ros2pkg</test_depend>
  <test_depend>twist_mux</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
